// Bottom status bar via zjstatus, replacing the bar.wezterm look:
// numbered tabs "1: title", mode indicator, session, git branch, time.

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                // rosé pine moon
                color_base    "#232136"
                color_overlay "#393552"
                color_muted   "#6e6a86"
                color_subtle  "#908caa"
                color_text    "#e0def4"
                color_love    "#eb6f92"
                color_gold    "#f6c177"
                color_rose    "#ebbcba"
                color_pine    "#31748f"
                color_foam    "#9ccfd8"
                color_iris    "#c4a7e7"

                format_left   "#[bg=$base]{mode}#[fg=$subtle,bg=$base] {session}"
                format_center "{tabs}"
                format_right  "{swap_layout}{command_git_branch}#[fg=$subtle,bg=$base]{datetime}"
                format_space  "#[bg=$base]"

                format_hide_on_overlength "true"
                format_precedence "clr"

                mode_normal        "#[fg=$base,bg=$pine,bold] {name} "
                mode_locked        "#[fg=$base,bg=$muted,bold] {name} "
                mode_resize        "#[fg=$base,bg=$gold,bold] {name} "
                mode_pane          "#[fg=$base,bg=$foam,bold] {name} "
                mode_tab           "#[fg=$base,bg=$iris,bold] {name} "
                mode_scroll        "#[fg=$base,bg=$gold,bold] {name} "
                mode_enter_search  "#[fg=$base,bg=$gold,bold] {name} "
                mode_search        "#[fg=$base,bg=$gold,bold] {name} "
                mode_rename_tab    "#[fg=$base,bg=$love,bold] {name} "
                mode_rename_pane   "#[fg=$base,bg=$love,bold] {name} "
                mode_session       "#[fg=$base,bg=$iris,bold] {name} "
                mode_move          "#[fg=$base,bg=$rose,bold] {name} "
                mode_default_to_mode "normal"

                tab_normal              "#[fg=$subtle,bg=$base] {index}: {name} "
                tab_normal_fullscreen   "#[fg=$subtle,bg=$base] {index}: {name} [] "
                tab_normal_sync         "#[fg=$subtle,bg=$base] {index}: {name} <> "
                tab_active              "#[fg=$base,bg=$iris,bold] {index}: {name} "
                tab_active_fullscreen   "#[fg=$base,bg=$iris,bold] {index}: {name} [] "
                tab_active_sync         "#[fg=$base,bg=$iris,bold] {index}: {name} <> "
                tab_separator           "#[fg=$muted,bg=$base] "
                tab_rename              "#[fg=$love,bg=$base] {index} {name} "
                tab_sync_indicator      "<> "
                tab_fullscreen_indicator "[] "
                tab_floating_indicator  "⬚ "

                swap_layout_format        "#[fg=$muted,bg=$base] {name} "
                swap_layout_hide_if_empty "true"

                command_git_branch_command    "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format     "#[fg=$foam,bg=$base] {stdout} "
                command_git_branch_interval   "10"
                command_git_branch_rendermode "static"

                datetime         "#[fg=$subtle,bg=$base] {format} "
                datetime_format  "%d %b %H:%M"
                datetime_timezone "Asia/Dhaka"
            }
        }
    }
}
