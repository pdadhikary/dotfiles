theme = dark:Rose Pine Moon,light:Rose Pine Dawn

# Zellij owns tabs/panes/splits (see zellij/.config/zellij) — ghostty is a
# thin host: no tab bar, all alt-key workflows live inside zellij/nvim.

# Hide the GTK tab bar (tab overview still available via toggle_tab_overview)
gtk-tabs-location = hidden

# Mouse: right-click copies selection if present, otherwise pastes
right-click-action = copy-or-paste

# F11 fullscreen / F12 inspector (Wezterm debug overlay equivalent)
keybind = f11=toggle_fullscreen
keybind = f12=inspector:toggle

# Release the alt+number keys (Ghostty defaults) so zellij receives them
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind

maximized = true
